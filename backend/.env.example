PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5434
DB_USER=maas
DB_PASSWORD=maas
DB_NAME=maas

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES=7d

WEBHOOK_SECRET=zabbix-webhook-secret
FRONTEND_URL=http://localhost:3000
REPORTS_DIR=reports

# Mock is the safe default when Zabbix containers are not running.
# For real local Zabbix (docker compose), set:
#   ZABBIX_MOCK=false
#   ZABBIX_URL=http://localhost:8080/api_jsonrpc.php
#   ZABBIX_USER=Admin
#   ZABBIX_PASSWORD=zabbix
ZABBIX_MOCK=true
ZABBIX_URL=http://localhost:8080/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=zabbix

SEED_ON_BOOT=true
SEED_ADMIN_EMAIL=admin@ztc.ma
SEED_ADMIN_PASSWORD=password123
